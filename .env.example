DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-api.onrender.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DB_SSL_REQUIRE=1
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
DEMO_PASSWORD=change-me-strong-password
THROTTLE_LOGIN=5/min
DEMO_ADMIN_PASSWORD=

# Django API base URL (server-side only, never prefix with NEXT_PUBLIC_)
API_URL=https://your-api.onrender.com
# Server-only credentials used by the "Try as member / admin" buttons.
# Must match the passwords used when running `manage.py seed_demo`.
DEMO_MEMBER_PASSWORD=
DEMO_ADMIN_PASSWORD=